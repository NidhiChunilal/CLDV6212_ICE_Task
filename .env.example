# ==========================================
# Logistics Fleet Tracker - Environment Variables
# ==========================================

# Local Containerized Database
POSTGRES_DB=fleet_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# .NET Web API Connection String (Defaults to local Docker Postgres)
# To use Supabase, replace with: Host=aws-0-[region].pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.[project-ref];Password=[your-password]
DATABASE_URL=Host=localhost;Port=5432;Database=fleet_db;Username=postgres;Password=postgres

# Frontend API Target (Defaults to local backend port 5000)
VITE_API_URL=http://localhost:5000/api

# Supabase Cloud Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
